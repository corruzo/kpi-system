{
  "name": "spe-tpv",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o app/static/tailwind.css --minify",
    "build:fonts": "cp node_modules/@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2 node_modules/@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2 app/static/fonts/",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o app/static/tailwind.css --watch",
    "build:motion": "cp node_modules/motion/dist/motion.js app/static/vendor/motion.js"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "alpinejs": "3.14.8",
    "chart.js": "4.4.7",
    "motion": "^11.18.2",
    "tailwindcss": "3.4.17"
  }
}
