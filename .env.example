# Copie a .env (local) o cargue estas variables en su plataforma de despliegue.
SIGT_ENV=production
# Supabase → Project Settings → Database → Connection string (URI).
# Servidor persistente: "Session pooler" (puerto 5432). Serverless: "Transaction pooler" (6543).
SIGT_DATABASE_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Cadena aleatoria de 32+ caracteres:  python -c "import secrets; print(secrets.token_hex(32))"
SIGT_SECRET=
# Solo para el primer arranque con la base vacía; elimine la contraseña después.
SIGT_ADMIN_USER=admin
SIGT_ADMIN_NAME=Administrador SGC
SIGT_ADMIN_PASSWORD=
SIGT_TRUST_PROXY=1
